<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageDescription>
            Provides the ability to provide additional commands to the hosted
            application by convention.
        </PackageDescription>
        <PackageTags>$(PackageTags);command line;cli;command</PackageTags>
        <NoWarn>$(NoWarn);RCS1102;CA1812</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Clavus\Rocket.Surgery.Clavus.csproj" />
        <ProjectReference Include="..\Clavus.Hosting/Rocket.Surgery.Clavus.Hosting.csproj" />

        <ProjectReference
            Include="..\Clavus.Analyzers\Rocket.Surgery.Clavus.Analyzers.csproj"
            IncludeAssets="analyzers;build;buildMultitargeting;buildTransitive"
            ExcludeAssets="compile;runtime;native"
            PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.CommandLine.Tests" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.Diagnostics" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.Tests" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.Hosting" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.Hosting.Abstractions" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.Web.Hosting" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.WebAssembly.Hosting" />
        <InternalsVisibleTo Include="Rocket.Surgery.Clavus.WebAssembly.Hosting.Abstractions" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Temp\*.cs" />
        <None Include="CommandLineHostBuilderExtensions.cs" />
        <None Include="Temp\*.cs" />
    </ItemGroup>
</Project>
