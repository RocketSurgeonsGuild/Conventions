<Project>
  <PropertyGroup>
    <ClavusMetadata Condition="'$(ClavusMetadata)' == ''">false</ClavusMetadata>
<!--    <ClavusCategory Condition="'$(ClavusCategory)' == ''"></ClavusCategory>-->
<!--    <ClavusHostType Condition="'$(ClavusHostType)' == ''"></ClavusHostType>-->
    <ClavusAssignExternal Condition="'$(ClavusAssignExternal)' == ''">false</ClavusAssignExternal>

    <ClavusImportNamespace Condition="'$(ClavusImportNamespace)' == ''">$(RootNamespace)</ClavusImportNamespace>
    <ClavusImportClassName Condition="'$(ClavusImportClassName)' == ''">Imports</ClavusImportClassName>
    <ClavusImportMethodName Condition="'$(ClavusImportMethodName)' == ''">Ashlar</ClavusImportMethodName>

    <ClavusExportNamespace Condition="'$(ClavusExportNamespace)' == ''">$(RootNamespace).Tectum</ClavusExportNamespace>
    <ClavusExportClassName Condition="'$(ClavusExportClassName)' == ''">Exports</ClavusExportClassName>
    <ClavusExportMethodName Condition="'$(ClavusExportMethodName)' == ''">Ashlar</ClavusExportMethodName>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="RootNamespace"/>
    <CompilerVisibleProperty Include="IsTestProject"/>

    <CompilerVisibleProperty Include="ClavusMetadata"/>
    <CompilerVisibleProperty Include="ClavusCategory"/>
    <CompilerVisibleProperty Include="ClavusHostType"/>
    <CompilerVisibleProperty Include="ClavusAssignExternal"/>

    <CompilerVisibleProperty Include="ClavusImportNamespace"/>
    <CompilerVisibleProperty Include="ClavusImportClassName"/>
    <CompilerVisibleProperty Include="ClavusImportMethodName"/>

    <CompilerVisibleProperty Include="ClavusExportNamespace"/>
    <CompilerVisibleProperty Include="ClavusExportClassName"/>
    <CompilerVisibleProperty Include="ClavusExportMethodName"/>
  </ItemGroup>


  <!-- ClavusPart item metadata schema -->
  <ItemDefinitionGroup>
    <ClavusPart>
      <Namespace></Namespace>
      <ProvideConfiguration></ProvideConfiguration>
      <ProvideServices></ProvideServices>
      <ParameterType></ParameterType>
      <ParameterName></ParameterName>
      <BuilderMethodName></BuilderMethodName>
      <GenericParameter></GenericParameter>
      <GenericConstraint></GenericConstraint>
      <GenericVariance></GenericVariance>
      <IsAsync></IsAsync>
    </ClavusPart>
  </ItemDefinitionGroup>

  <!-- ClavusHost item metadata schema -->
  <ItemDefinitionGroup>
    <ClavusHost>
      <Namespace></Namespace>
      <HostBuilderType></HostBuilderType>
      <HostBuilderName></HostBuilderName>
      <HostType></HostType>
      <HelperName></HelperName>
      <HasBuildExpression></HasBuildExpression>
      <BuildExpression></BuildExpression>
    </ClavusHost>
  </ItemDefinitionGroup>
  <Import Project="$(MSBuildThisFileDirectory)Clavus.Parts.targets" Condition="'$(_ClavusPartsTargetsImported)' != 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)Clavus.ContextBuilder.targets" Condition="'$(_ClavusContextBuilderTargetsImported)' != 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)Clavus.Hosts.targets" Condition="'$(_ClavusHostsTargetsImported)' != 'true'"/>
  <Import Project="$(MSBuildThisFileDirectory)Clavus.Reference.targets"/>
  <Import Project="$(MSBuildThisFileDirectory)Clavus.Metadata.targets"/>
</Project>
