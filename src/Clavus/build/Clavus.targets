<Project>
    <PropertyGroup>
        <ImportClavusNamespace Condition="'$(ImportClavusNamespace)' == ''">$(RootNamespace)</ImportClavusNamespace>
        <ImportClavusClassName Condition="'$(ImportClavusClassName)' == ''">Imports</ImportClavusClassName>
        <ImportClavusMethodName Condition="'$(ImportClavusMethodName)' == ''">Ashlar</ImportClavusMethodName>

        <ExportClavusNamespace Condition="'$(ExportClavusNamespace)' == ''">$(RootNamespace).Tectum</ExportClavusNamespace>
        <ExportClavusClassName Condition="'$(ExportClavusClassName)' == ''">Exports</ExportClavusClassName>
        <ExportClavusMethodName Condition="'$(ExportClavusMethodName)' == ''">Ashlar</ExportClavusMethodName>
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="ImportClavusAssembly" />
        <CompilerVisibleProperty Include="ImportClavusNamespace" />
        <CompilerVisibleProperty Include="ImportClavusClassName" />
        <CompilerVisibleProperty Include="ImportClavusMethodName" />

        <CompilerVisibleProperty Include="ExportClavusAssembly" />
        <CompilerVisibleProperty Include="ExportClavusNamespace" />
        <CompilerVisibleProperty Include="ExportClavusClassName" />
        <CompilerVisibleProperty Include="ExportClavusMethodName" />

        <CompilerVisibleProperty Include="IsTestProject" />
    </ItemGroup>

    <!-- ClavusPart item metadata schema -->
    <ItemDefinitionGroup>
        <ClavusPart>
            <Namespace></Namespace>
            <ProvideConfiguration></ProvideConfiguration>
            <ProvideServices></ProvideServices>
            <ParameterType></ParameterType>
            <ParameterName></ParameterName>
            <BuilderMethodName></BuilderMethodName>
            <GenericParameter></GenericParameter>
            <GenericConstraint></GenericConstraint>
            <GenericVariance></GenericVariance>
        </ClavusPart>
    </ItemDefinitionGroup>

    <!-- ClavusHost item metadata schema -->
    <ItemDefinitionGroup>
        <ClavusHost>
            <Namespace></Namespace>
            <HostBuilderType></HostBuilderType>
            <HostBuilderName></HostBuilderName>
            <HostType></HostType>
            <HelperName></HelperName>
            <HasBuildExpression></HasBuildExpression>
            <BuildExpression></BuildExpression>
        </ClavusHost>
    </ItemDefinitionGroup>
    <Import Project="$(MSBuildThisFileDirectory)Clavus.Parts.targets" Condition="'$(_ClavusPartsTargetsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)Clavus.ContextBuilder.targets" Condition="'$(_ClavusContextBuilderTargetsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)Clavus.Hosts.targets" Condition="'$(_ClavusHostsTargetsImported)' != 'true'" />
</Project>
