<Project>
    <Choose>
        <When Condition=" '$(UsingMicrosoftNETSdkBlazorWebAssembly)'=='true' or '$(UsingMicrosoftNETSdkWebAssembly)'=='true' ">
            <PropertyGroup>
                <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
            </PropertyGroup>
            <ItemGroup>
                <ClavusHost
                    Include="WebAssembly"
                    HostBuilderType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHostBuilder"
                    HostBuilderName="builder"
                    HostType="Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHost"
                />
                <PackageReference
                    Include="Clavus.Hosting.WebAssembly"
                    Version="TODO"
                    Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.WebAssembly')) != 'true'"
                    IsImplicitlyDefined="true"
                    PrivateAssets="all"
                    IncludeAssets="runtime; build; native; contentfiles; analyzers"
                />
            </ItemGroup>
        </When>
        <When Condition=" '$(UsingMicrosoftNETSdkRazor)'=='true' or '$(UsingMicrosoftNETSdkWeb)'=='true' ">
            <PropertyGroup>
                <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
            </PropertyGroup>
            <ItemGroup>
                <ClavusHost
                    Include="WebApplication"
                    HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder"
                    HostBuilderName="builder"
                    HostType="global::Microsoft.AspNetCore.Builder.WebApplication"
                    HelperName="global::Clavus.ClavusHostApplicationHelpers"
                />
                <PackageReference
                    Include="Clavus.Hosting.Web"
                    Version="TODO"
                    Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.Web')) != 'true'"
                    IsImplicitlyDefined="true"
                    PrivateAssets="all"
                    IncludeAssets="runtime; build; native; contentfiles; analyzers"
                />
            </ItemGroup>
        </When>
        <When Condition=" '$(UsingMicrosoftNETSdkWorker)'=='true' or ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'exe') ">
            <PropertyGroup>
                <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
            </PropertyGroup>
            <ItemGroup>
                <ClavusHost
                    Include="HostApplication"
                    HostBuilderType="global::Microsoft.Extensions.Hosting.HostApplicationBuilder"
                    HostBuilderName="builder"
                    HostType="global::Microsoft.Extensions.Hosting.IHost"
                    HelperName="global::Clavus.ClavusHostApplicationHelpers"
                />
                <PackageReference
                    Include="Clavus.Hosting"
                    Version="TODO"
                    Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting')) != 'true'"
                    IsImplicitlyDefined="true"
                    PrivateAssets="all"
                    IncludeAssets="runtime; build; native; contentfiles; analyzers"
                />
            </ItemGroup>
        </When>
        <When Condition=" '$(UsingMicrosoftMauiSdk)'=='true' ">
            <PropertyGroup>
                <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
            </PropertyGroup>
            <ItemGroup>
                <ClavusHost
                    Include="Maui"
                    HostBuilderType="global::Microsoft.Maui.Hosting.MauiAppBuilder"
                    HostBuilderName="builder"
                    HostType="global::Microsoft.Maui.Hosting.MauiApp"
                />
                <PackageReference
                    Include="Clavus.Hosting.Maui"
                    Version="TODO"
                    Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.Maui')) != 'true'"
                    IsImplicitlyDefined="true"
                    PrivateAssets="all"
                    IncludeAssets="runtime; build; native; contentfiles; analyzers"
                />
            </ItemGroup>
        </When>
        <When Condition=" '$(UsingUnoSdk)'=='true' ">
            <PropertyGroup>
                <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
            </PropertyGroup>
            <ItemGroup>
                <ClavusHost
                    Include="Uno"
                    HostBuilderType="global::Uno.UI.Hosting.IUnoPlatformHostBuilder"
                    HostBuilderName="builder"
                    HostType="global::Uno.UI.Hosting.UnoPlatformHost"
                />
                <PackageReference
                    Include="Clavus.Hosting.Uno"
                    Version="TODO"
                    Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.Uno')) != 'true'"
                    IsImplicitlyDefined="true"
                    PrivateAssets="all"
                    IncludeAssets="runtime; build; native; contentfiles; analyzers"
                />
            </ItemGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <_ClavusApplicationDetected>false</_ClavusApplicationDetected>
            </PropertyGroup>
        </Otherwise>
        <!-- leaving aspire out for the moment -->
        <!-- <When Condition=" '$(IsAspireHost)'=='true' ">
            <ItemGroup>
                <ClavusHost Include="Aspire" HostBuilderType="Aspire.Hosting.IDistributedApplicationBuilder" HostBuilderName="builder" HostType="Aspire.Hosting.DistributedApplication" />
            </ItemGroup>
        </When> -->
    </Choose>

    <!-- clavus-managed-configuration MSBuild surface (discovery, packing, copy, gitignore scaffold). -->
    <Import Project="$(MSBuildThisFileDirectory)Clavus.Configuration.targets" Condition="'$(ClavusEnableConfiguration)' == 'true'" />

    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">true</ImportClavusAssembly>
        <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">false</ExportClavusAssembly>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ConventionApplicationDetected)' == 'true'">
        <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">true</ImportClavusAssembly>
        <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">true</ExportClavusAssembly>
    </PropertyGroup>

    <PropertyGroup Condition="'$(_ConventionApplicationDetected)' != 'true'">
        <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">false</ImportClavusAssembly>
        <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">true</ExportClavusAssembly>
    </PropertyGroup>

    <!-- Flag-gated optional package references -->
    <ItemGroup>
        <PackageReference
            Include="Clavus.Autofac"
            Version="TODO"
            Condition="'$(ClavusEnableAutofac)' == 'true' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Autofac')) != 'true'"
            IsImplicitlyDefined="true"
        />
        <PackageReference
            Include="Clavus.DryIoc"
            Version="TODO"
            Condition="'$(ClavusEnableDryIoc)' == 'true' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.DryIoc')) != 'true'"
            IsImplicitlyDefined="true"
        />
        <PackageReference
            Include="Clavus.Serilog"
            Version="TODO"
            Condition="'$(ClavusEnableSerilog)' == 'true' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Serilog')) != 'true'"
            IsImplicitlyDefined="true"
        />
    </ItemGroup>
</Project>
