<Project>
    <!--
        Sdk.props — runs early, before project evaluation.
        Defines the ClavusPart item schema and default feature flags.
        Core PackageReferences that every Clavus consumer gets automatically.
    -->

    <!-- User-facing feature flags (all default false) -->
    <PropertyGroup>
        <ClavusEnableJsonConfiguration Condition="'$(ClavusEnableJsonConfiguration)' == ''">false</ClavusEnableJsonConfiguration>
        <ClavusEnableYamlConfiguration Condition="'$(ClavusEnableYamlConfiguration)' == ''">false</ClavusEnableYamlConfiguration>
        <ClavusEnableAutofac Condition="'$(ClavusEnableAutofac)' == ''">false</ClavusEnableAutofac>
        <ClavusEnableDryIoc Condition="'$(ClavusEnableDryIoc)' == ''">false</ClavusEnableDryIoc>
        <ClavusEnableSerilog Condition="'$(ClavusEnableSerilog)' == ''">false</ClavusEnableSerilog>
    </PropertyGroup>

    <!-- Core packages every Clavus consumer gets automatically -->
    <ItemGroup>
        <PackageReference Include="Clavus" />
    </ItemGroup>
</Project>
