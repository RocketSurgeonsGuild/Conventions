<Project>
  <!--
      Registered via CustomAfterMicrosoftCommonTargets (see Sdk.props) instead of living inline in
      Sdk.targets. Sdk.targets is imported by Directory.Build.props's own trailing SDK-targets slot,
      which runs BEFORE the consuming project's own body (e.g. a worker.csproj's <OutputType>Exe</OutputType>)
      is ever evaluated - so a Choose block reading $(OutputType) there always sees it empty. Deferring
      via CustomAfterMicrosoftCommonTargets runs this after the whole project body (and Directory.Build.targets)
      has been evaluated, while still being early enough (pure evaluation, no Target execution yet) for the
      ClavusSdkImplicitPackageReference items below to reach NuGet restore.
  -->
  <Choose>
    <When Condition=" '$(UsingMicrosoftNETSdkBlazorWebAssembly)'=='true' or '$(UsingMicrosoftNETSdkWebAssembly)'=='true' ">
      <PropertyGroup>
        <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
      </PropertyGroup>
      <ItemGroup>
        <ClavusHost Include="WebAssembly" HostBuilderType="global::Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHostBuilder" HostBuilderName="builder" HostType="Microsoft.AspNetCore.Components.WebAssembly.Hosting.WebAssemblyHost"/>
        <ClavusSdkImplicitPackageReference Include="Clavus.Hosting.WebAssembly" Version="$(ClavusHostingWebAssemblyVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers"/>
      </ItemGroup>
    </When>
    <When Condition=" '$(UsingMicrosoftNETSdkRazor)'=='true' or '$(UsingMicrosoftNETSdkWeb)'=='true' ">
      <PropertyGroup>
        <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
      </PropertyGroup>
      <ItemGroup>
        <ClavusHost Include="WebApplication" HostBuilderType="global::Microsoft.AspNetCore.Builder.WebApplicationBuilder" HostBuilderName="builder" HostType="global::Microsoft.AspNetCore.Builder.WebApplication" HelperName="global::Clavus.ClavusHostApplicationHelpers"/>
        <ClavusSdkImplicitPackageReference Include="Clavus.Hosting.Web" Version="$(ClavusHostingWebVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers"/>
      </ItemGroup>
    </When>
    <When Condition=" '$(UsingMicrosoftNETSdkWorker)'=='true' or ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'exe') ">
      <PropertyGroup>
        <_ClavusApplicationDetected>true</_ClavusApplicationDetected>
      </PropertyGroup>
      <ItemGroup>
        <ClavusHost Include="HostApplication" HostBuilderType="global::Microsoft.Extensions.Hosting.HostApplicationBuilder" HostBuilderName="builder" HostType="global::Microsoft.Extensions.Hosting.IHost" HelperName="global::Clavus.ClavusHostApplicationHelpers"/>
        <ClavusSdkImplicitPackageReference Include="Clavus.Hosting" Version="$(ClavusHostingVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers"/>
      </ItemGroup>
    </When>
    <!--    <When Condition=" '$(UsingMicrosoftMauiSdk)'=='true' ">-->
    <!--      <PropertyGroup>-->
    <!--        <_ClavusApplicationDetected>true</_ClavusApplicationDetected>-->
    <!--      </PropertyGroup>-->
    <!--      <ItemGroup>-->
    <!--        <ClavusHost-->
    <!--          Include="Maui"-->
    <!--          HostBuilderType="global::Microsoft.Maui.Hosting.MauiAppBuilder"-->
    <!--          HostBuilderName="builder"-->
    <!--          HostType="global::Microsoft.Maui.Hosting.MauiApp"-->
    <!--        />-->
    <!--        <PackageReference-->
    <!--          Include="Clavus.Hosting.Maui"-->
    <!--          Version="TODO"-->
    <!--          Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.Maui')) != 'true'"-->
    <!--          IsImplicitlyDefined="true"-->
    <!--          PrivateAssets="all"-->
    <!--          IncludeAssets="runtime; build; native; contentfiles; analyzers"-->
    <!--        />-->
    <!--      </ItemGroup>-->
    <!--    </When>-->
    <!--    <When Condition=" '$(UsingUnoSdk)'=='true' ">-->
    <!--      <PropertyGroup>-->
    <!--        <_ClavusApplicationDetected>true</_ClavusApplicationDetected>-->
    <!--      </PropertyGroup>-->
    <!--      <ItemGroup>-->
    <!--        <ClavusHost-->
    <!--          Include="Uno"-->
    <!--          HostBuilderType="global::Uno.UI.Hosting.IUnoPlatformHostBuilder"-->
    <!--          HostBuilderName="builder"-->
    <!--          HostType="global::Uno.UI.Hosting.UnoPlatformHost"-->
    <!--        />-->
    <!--        <ClavusSdkImplicitPackageReference-->
    <!--          Include="Clavus.Hosting.Uno"-->
    <!--          Version="TODO"-->
    <!--          Condition="@(PackageReference->AnyHaveMetadataValue('Identity', 'Clavus.Hosting.Uno')) != 'true'"-->
    <!--          PrivateAssets="all"-->
    <!--          IncludeAssets="runtime; build; native; contentfiles; analyzers"-->
    <!--        />-->
    <!--      </ItemGroup>-->
    <!--    </When>-->
    <Otherwise>
      <PropertyGroup>
        <_ClavusApplicationDetected>false</_ClavusApplicationDetected>
      </PropertyGroup>
    </Otherwise>
    <!-- leaving aspire out for the moment -->
    <!-- <When Condition=" '$(IsAspireHost)'=='true' ">
            <ItemGroup>
                <ClavusHost Include="Aspire" HostBuilderType="Aspire.Hosting.IDistributedApplicationBuilder" HostBuilderName="builder" HostType="Aspire.Hosting.DistributedApplication" />
            </ItemGroup>
        </When> -->
  </Choose>

  <PropertyGroup>
    <ClavusPackConfiguration Condition="'$(ClavusPackConfiguration)' == ''">$(IsPackable)</ClavusPackConfiguration>
  </PropertyGroup>

  <!--
      Import order matters here:
      1. Clavus.PackConfiguration.targets defaults the per-format ClavusEnable{Format}Configuration
         flags from appsettings.{ext} file presence (explicit project values win) and defines the
         rename/pack/copy + gated code-emission surface.
      2. ClavusEnableConfiguration aggregates those flags — computed AFTER the import so
         file-presence defaults are reflected. An explicit consumer value always wins.
      3. Clavus.Configuration.targets (gated on the aggregate) adds the provider PackageReferences
         and the gitignore warning.
    -->
  <Import Project="$(MSBuildThisFileDirectory)Clavus.PackConfiguration.targets" Condition="'$(ClavusPackConfiguration)' == 'true'"/>

  <PropertyGroup>
    <ClavusEnableAutofac Condition="'$(ClavusEnableAutofac)' == ''">false</ClavusEnableAutofac>
    <ClavusEnableDryIoc Condition="'$(ClavusEnableDryIoc)' == ''">false</ClavusEnableDryIoc>
    <ClavusEnableSerilog Condition="'$(ClavusEnableSerilog)' == ''">false</ClavusEnableSerilog>
    <ClavusEnableOpenTelemetry Condition="'$(ClavusEnableOpenTelemetry)' == ''">false</ClavusEnableOpenTelemetry>
    <ClavusEnableHosting Condition="'$(ClavusEnableHosting)' == ''">false</ClavusEnableHosting>
    <ClavusEnableHostingWeb Condition="'$(ClavusEnableHostingWeb)' == ''">false</ClavusEnableHostingWeb>
    <ClavusEnableAspire Condition="'$(ClavusEnableAspireHosting)' == ''">false</ClavusEnableAspire>
    <ClavusEnableAspireTesting Condition="'$(ClavusEnableAspireHostingTesting)' == ''">false</ClavusEnableAspireTesting>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Clavus.Configuration.targets" Condition="'$(ClavusEnableConfiguration)' == 'true'"/>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">true</ImportClavusAssembly>
    <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">false</ExportClavusAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ClavusApplicationDetected)' == 'true'">
    <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">true</ImportClavusAssembly>
    <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">true</ExportClavusAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_ClavusApplicationDetected)' != 'true'">
    <ImportClavusAssembly Condition="'$(ImportClavusAssembly)' == ''">false</ImportClavusAssembly>
    <ExportClavusAssembly Condition="'$(ExportClavusAssembly)' == ''">true</ExportClavusAssembly>
  </PropertyGroup>

  <!-- Flag-gated optional package references -->
  <ItemGroup>
    <ClavusSdkImplicitPackageReference Include="Clavus" Version="$(ClavusVersion)"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.Autofac" Version="$(ClavusAutofacVersion)" Condition="'$(ClavusEnableAutofac)' != 'false' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Autofac')) == 'true'"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.DryIoc" Version="$(ClavusDryIocVersion)" Condition="'$(ClavusEnableDryIoc)' != 'false' and @(PackageReference->AnyHaveMetadataValue('Identity', 'DryIoc')) == 'true'"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.Serilog" Version="$(ClavusSerilogVersion)" Condition="'$(ClavusEnableSerilog)' != 'false' and @(PackageReference->AnyHaveMetadataValue('Identity', 'Serilog')) == 'true'"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.OpenTelemetry" Version="$(ClavusOpenTelemetryVersion)" Condition="'$(ClavusEnableOpenTelemetry)' != 'false' and @(PackageReference->AnyHaveMetadataValue('Identity', 'OpenTelemetry')) == 'true'"/>
  </ItemGroup>
  <!-- Imported last: expands every RsgSdkImplicitPackageReference declared above (and in this
         file's own SBOM ItemGroup) into a real PackageReference. -->
  <Import Project="$(MSBuildThisFileDirectory)ImplicitPackageReferences.targets"/>
</Project>
