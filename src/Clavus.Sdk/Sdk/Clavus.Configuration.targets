<Project>

  <PropertyGroup>
    <ClavusEnableJsonConfiguration Condition="'$(ClavusEnableJsonConfiguration)' == ''">false</ClavusEnableJsonConfiguration>
    <ClavusEnableYamlConfiguration Condition="'$(ClavusEnableYamlConfiguration)' == ''">true</ClavusEnableYamlConfiguration>
    <ClavusEnableTomlConfiguration Condition="'$(ClavusEnableTomlConfiguration)' == ''">false</ClavusEnableTomlConfiguration>
  </PropertyGroup>

  <PropertyGroup>
    <ClavusEnableConfiguration Condition="'$(ClavusEnableConfiguration)' == '' and ('$(ClavusEnableJsonConfiguration)' == 'true' or '$(ClavusEnableYamlConfiguration)' == 'true' or '$(ClavusEnableTomlConfiguration)' == 'true')">true</ClavusEnableConfiguration>
    <ClavusEnableConfiguration Condition="'$(ClavusEnableConfiguration)' == ''">false</ClavusEnableConfiguration>
  </PropertyGroup>

  <ItemGroup Condition="'$(ClavusEnableConfiguration)' == 'true'">
    <ClavusSdkImplicitPackageReference Include="Clavus.Configuration.Json" Version="$(ClavusConfigurationJsonVersion)" Condition="'$(ClavusEnableJsonConfiguration)' == 'true'"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.Configuration.Yaml" Version="$(ClavusConfigurationYamlVersion)" Condition="'$(ClavusEnableYamlConfiguration)' == 'true'"/>
    <ClavusSdkImplicitPackageReference Include="Clavus.Configuration.Toml" Version="$(ClavusConfigurationTomlVersion)" Condition="'$(ClavusEnableTomlConfiguration)' == 'true'"/>
  </ItemGroup>

  <!--
    .gitignore warning (task 1.6): appsettings.local.{ext} is a developer-machine-only
    override layer (design.md Decision 8) and must never be committed. Warn instead of
    writing to the project's .gitignore, so the developer stays in control of that file.
  -->
  <Target Name="_ClavusScaffoldLocalConfigurationGitIgnore"
          Condition="'$(ClavusEnableConfiguration)' == 'true'"
          BeforeTargets="Build;Restore">
    <PropertyGroup>
      <_ClavusGitIgnorePath>$(MSBuildProjectDirectory)\.gitignore</_ClavusGitIgnorePath>
      <_ClavusGitIgnoreExistingContent Condition="Exists('$(_ClavusGitIgnorePath)')">$([System.IO.File]::ReadAllText('$(_ClavusGitIgnorePath)'))</_ClavusGitIgnoreExistingContent>
      <_ClavusGitIgnoreNeedsEntry Condition="'$(_ClavusGitIgnoreExistingContent)' == '' or !$(_ClavusGitIgnoreExistingContent.Contains('appsettings.local.'))">true</_ClavusGitIgnoreNeedsEntry>
    </PropertyGroup>
    <Warning
      Text="ClavusConfiguration: '$(_ClavusGitIgnorePath)' does not appear to ignore appsettings.local.{json,yaml,yml,toml}. Add those patterns to your .gitignore so local-only configuration overrides are never committed."
      Condition="'$(_ClavusGitIgnoreNeedsEntry)' == 'true'"/>
  </Target>
</Project>
