<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageDescription>
            Adds helpers to easily bootstrap an application using conventions by
            just using the correct extension method. This adds command line operations, additional
            configuration, logging and service injections by convention.
        </PackageDescription>
        <PackageTags>$(PackageTags);hosting;generic host</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Clavus\Clavus.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Aspire.Hosting.Tests" />
        <PackageReference Include="Aspire.Hosting" />
    </ItemGroup>
  <ItemGroup>
    <ClavusPart Include="DistributedApplication"
                Namespace="Clavus"
                ParameterType="Aspire.Hosting.IDistributedApplicationBuilder"
                ParameterName="builder" />
  </ItemGroup>
</Project>
