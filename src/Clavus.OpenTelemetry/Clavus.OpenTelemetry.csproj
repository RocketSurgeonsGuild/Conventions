<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageDescription>Provides OpenTelemetry support for a Rocket Surgery Application</PackageDescription>
    <PackageTags>$(PackageTags);OpenTelemetry</PackageTags>
    <RootNamespace>Clavus</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <ClavusPart Include="TracerProvider" Namespace="Clavus" IsAsync="false" ParameterType="global::OpenTelemetry.Trace.TracerProviderBuilder" ParameterName="builder"/>
    <ClavusPart Include="MeterProvider" Namespace="Clavus" IsAsync="false" ParameterType="global::OpenTelemetry.Metrics.MeterProviderBuilder" ParameterName="builder"/>
    <ClavusPart Include="LoggerProvider" Namespace="Clavus" IsAsync="false" ParameterType="global::OpenTelemetry.Logs.LoggerProviderBuilder" ParameterName="builder"/>
    <ClavusPart Include="ResourceBuilder" Namespace="Clavus" IsAsync="false" ParameterType="global::OpenTelemetry.Resources.ResourceBuilder" ParameterName="builder"/>
    <ClavusPart Include="OpenTelemetry" Namespace="Clavus" ParameterType="global::OpenTelemetry.IOpenTelemetryBuilder" ParameterName="builder"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry"/>
    <ProjectReference Include="..\Clavus\Clavus.csproj"/>

    <ProjectReference
      Include="..\Clavus.Analyzers\Clavus.Analyzers.csproj"
      IncludeAssets="analyzers;build;buildMultitargeting;buildTransitive"
      ExcludeAssets="compile;runtime;native"
      PrivateAssets="contentfiles;build;buildMultitargeting;buildTransitive"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
